<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.knivram.airlockiamconfigplugin</id>
    <name>Airlock IAM Config</name>
    <vendor>knivram</vendor>
    <description><![CDATA[
        <p>Editor support for <b>Airlock IAM</b> configuration files (<code>type: IamConfig</code>, <code>schemaVersion: iam.airlock.com/&hellip;</code>).</p>
        <ul>
            <li><b>Go to definition</b> &mdash; jump from a <code>ref:</code>/<code>parentRef:</code> to the plugin <code>id:</code> it points at.</li>
            <li><b>Find usages</b> &mdash; from a plugin's <code>id:</code>, list every place it is referenced.</li>
            <li><b>Code completion</b> &mdash; complete <code>ref:</code> values (pick an existing plugin by name), <code>type:</code> values (constrained to the plugins valid for the surrounding slot), and plugin <b>property names</b>.</li>
            <li><b>Inspections</b> &mdash; flag dangling references and duplicate plugin ids, plus warn on unknown properties and wrong child plugin types for known Airlock plugin types.</li>
        </ul>
        <p>Everything is scoped to a single file, so duplicating a config (e.g. a production copy) does not cause false duplicate-id warnings.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <resource-bundle>messages.AirlockBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Airlock IAM file icon for IamConfig files. -->
        <iconProvider implementation="com.github.knivram.airlockiamconfigplugin.icon.AirlockIamIconProvider"/>

        <!-- Go to definition: ref:/parentRef: -> plugin id: (within the same file). -->
        <psi.referenceContributor language="yaml"
                                  implementation="com.github.knivram.airlockiamconfigplugin.reference.RefReferenceContributor"/>
        <!-- Cmd/Ctrl+B on a plugin id value -> navigate to its usages. -->
        <gotoDeclarationHandler implementation="com.github.knivram.airlockiamconfigplugin.navigation.IamConfigGotoDeclarationHandler"/>

        <!-- Find Usages: from a plugin id: -> all ref:/parentRef: pointing at it. -->
        <findUsagesHandlerFactory order="first"
                                  implementation="com.github.knivram.airlockiamconfigplugin.usage.IamConfigFindUsagesHandlerFactory"/>
        <!-- Offer the plugin as the find-usages target when the caret is on the id value itself. -->
        <usageTargetProvider implementation="com.github.knivram.airlockiamconfigplugin.usage.IamConfigUsageTargetProvider"/>

        <!-- Completion of ref: values and type: values. -->
        <completion.contributor language="yaml"
                                 implementationClass="com.github.knivram.airlockiamconfigplugin.completion.AirlockCompletionContributor"/>

        <!-- Quick Documentation / hover docs for type:, property keys, ids and refs. -->
        <lang.documentationProvider language="yaml"
                                    implementationClass="com.github.knivram.airlockiamconfigplugin.documentation.AirlockDocumentationProvider"/>

        <!-- Labels ref:/parentRef: usages in the Find Usages tool window. -->
        <usageTypeProvider implementation="com.github.knivram.airlockiamconfigplugin.usage.IamConfigUsageTypeProvider"/>

        <!-- Validation. -->
        <localInspection language="yaml"
                         shortName="AirlockDanglingReference"
                         key="inspection.danglingRef.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="com.github.knivram.airlockiamconfigplugin.inspection.DanglingReferenceInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockDuplicateId"
                         key="inspection.duplicateId.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.github.knivram.airlockiamconfigplugin.inspection.DuplicateIdInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockUnknownProperty"
                         key="inspection.unknownProperty.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.github.knivram.airlockiamconfigplugin.inspection.UnknownPropertyInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockWrongChildType"
                         key="inspection.wrongChildType.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.github.knivram.airlockiamconfigplugin.inspection.WrongChildTypeInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockMissingMandatoryProperty"
                         key="inspection.missingMandatory.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="false"
                         level="WARNING"
                         implementationClass="com.github.knivram.airlockiamconfigplugin.inspection.MissingMandatoryPropertyInspection"/>
    </extensions>
</idea-plugin>
