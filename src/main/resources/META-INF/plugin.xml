<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>me.knivram.IamPlugin</id>
    <name>Config Navigator</name>
    <vendor>knivram</vendor>
    <description><![CDATA[
        <p>Editor support for <b>Airlock IAM</b> configuration files (<code>type: IamConfig</code>, <code>schemaVersion: iam.airlock.com/&hellip;</code>), powered by a bundled catalog of the IAM 8.6 plugin types &mdash; their properties, allowed child plugins and documentation.</p>
        <ul>
            <li><b>Navigation</b> &mdash; jump from a <code>ref:</code>/<code>parentRef:</code> to the plugin <code>id:</code> it points at; from an <code>id:</code>, Find Usages (or Ctrl/Cmd+B) lists everything that references it.</li>
            <li><b>Code completion</b> &mdash; <code>ref:</code> values (existing plugins, shown by display name, matched case-insensitively); <code>type:</code> values (constrained to the plugins valid for the surrounding slot, else the full catalog); plugin <b>property names</b>; plugin-definition keys (<code>type</code>/<code>id</code>/<code>displayName</code>/<code>comment</code>/<code>parentRef</code>/<code>properties</code>); <code>pluginList</code>/<code>pluginMap</code> scaffolds; and <code>env:</code>/<code>var:</code> for environment-specific values.</li>
            <li><b>Quick documentation</b> &mdash; hover (or Ctrl-Q) a <code>type:</code>, a property key, or a <code>ref:</code>/<code>id:</code> to see the plugin's description, properties and allowed child types.</li>
            <li><b>Folding</b> &mdash; a <code>ref:</code> id is shown as the referenced plugin's display name; expand it to see the id.</li>
            <li><b>Inspections</b> &mdash; dangling references, duplicate ids, unknown properties, wrong child plugin types, missing mandatory properties (with a quick-fix that adds them; a Mandatory Plugin-Link auto-linked from a global default &mdash; a singleton configured in the global <code>GlobalConfiguration</code> settings tree, e.g. under <code>GlobalAuthenticationSettings</code> or <code>GlobalPersisterSettings</code> &mdash; is not flagged), and variable/environment misconfigurations.</li>
            <li>A dedicated <b>file icon</b> for IamConfig files.</li>
        </ul>
        <p>Everything is scoped to a single file (so duplicating a config &mdash; e.g. a production copy &mdash; does not cause false duplicate-id warnings), and validation only applies to plugin types known in the bundled catalog, so custom plugins are never flagged.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <resource-bundle>messages.AirlockBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Airlock IAM file icon for IamConfig files. -->
        <iconProvider implementation="me.knivram.iamplugin.icon.AirlockIamIconProvider"/>

        <!-- Go to definition: ref:/parentRef: -> plugin id: (within the same file). -->
        <psi.referenceContributor language="yaml"
                                  implementation="me.knivram.iamplugin.reference.RefReferenceContributor"/>
        <!-- Cmd/Ctrl+B on a plugin id value -> navigate to its usages. -->
        <gotoDeclarationHandler implementation="me.knivram.iamplugin.navigation.IamConfigGotoDeclarationHandler"/>

        <!-- Find Usages: from a plugin id: -> all ref:/parentRef: pointing at it. -->
        <findUsagesHandlerFactory order="first"
                                  implementation="me.knivram.iamplugin.usage.IamConfigFindUsagesHandlerFactory"/>
        <!-- Offer the plugin as the find-usages target when the caret is on the id value itself. -->
        <usageTargetProvider implementation="me.knivram.iamplugin.usage.IamConfigUsageTargetProvider"/>

        <!-- Completion of ref: values and type: values. order="first" so our providers run before the
             platform's YamlStructuralKeysCompletionContributor; result.stopHere() then suppresses its
             generic sibling-inferred keys (otherwise type/id/properties would be offered twice). -->
        <completion.contributor language="yaml" order="first"
                                 implementationClass="me.knivram.iamplugin.completion.AirlockCompletionContributor"/>

        <!-- Quick Documentation / hover docs for type:, property keys, ids and refs. -->
        <lang.documentationProvider language="yaml"
                                    implementationClass="me.knivram.iamplugin.documentation.AirlockDocumentationProvider"/>

        <!-- Labels ref:/parentRef: usages in the Find Usages tool window. -->
        <usageTypeProvider implementation="me.knivram.iamplugin.usage.IamConfigUsageTypeProvider"/>

        <!-- Fold a ref:/parentRef: id to the resolved plugin's displayName (display-only; text stays the id). -->
        <lang.foldingBuilder language="yaml"
                             implementationClass="me.knivram.iamplugin.folding.RefDisplayNameFoldingBuilder"/>

        <!-- Validation. -->
        <localInspection language="yaml"
                         shortName="AirlockDanglingReference"
                         key="inspection.danglingRef.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="me.knivram.iamplugin.inspection.DanglingReferenceInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockDuplicateId"
                         key="inspection.duplicateId.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="me.knivram.iamplugin.inspection.DuplicateIdInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockUnknownProperty"
                         key="inspection.unknownProperty.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="me.knivram.iamplugin.inspection.UnknownPropertyInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockWrongChildType"
                         key="inspection.wrongChildType.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="me.knivram.iamplugin.inspection.WrongChildTypeInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockMissingMandatoryProperty"
                         key="inspection.missingMandatory.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="ERROR"
                         implementationClass="me.knivram.iamplugin.inspection.MissingMandatoryPropertyInspection"/>
        <localInspection language="yaml"
                         shortName="AirlockVariableEnv"
                         key="inspection.variableEnv.displayName"
                         groupKey="inspection.group.name"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="me.knivram.iamplugin.inspection.VariableEnvInspection"/>
    </extensions>
</idea-plugin>
